        "activity.propose",
        "attendance.confirm.assigned",
        "project.submit.assigned"
      ],
      "scope": "assigned"
    },
    {
      "code": "MENTOR",
      "name": "技术/项目导师",
      "permissions": [
        "project.review.assigned",
        "assessment.review.assigned",
        "approval.decide.assigned"
      ],
      "scope": "assigned"
    },
    {
      "code": "REVIEWER",
      "name": "教员审核员",
      "permissions": [
        "identity.review",
        "approval.decide",
        "competition.review",
        "appeal.review.independent",
        "sanction.review"
