# Template only. A must generate random local secrets into ignored .env.local.
APP_MODE=demo
NODE_ENV=development
BUSINESS_TIMEZONE=Asia/Shanghai
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
API_PORT=3100
DATABASE_URL=
MYSQL_IMAGE=
LOCAL_UPLOAD_DIR=.local/uploads
AUTH_STUDENT_PROVIDER=demo
AUTH_STAFF_PROVIDER=local
STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=inapp
SESSION_SECRET=
DEMO_ACCESS_SECRET=
ALLOW_PUBLIC_SHARE=false
WX_APP_ID=
WX_APP_SECRET=
TENCENT_ENV_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# No image API required. Keep unused providers disabled.
IMAGE_PROVIDER=none
